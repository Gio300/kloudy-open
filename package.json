{
  "name": "@kloudy/open",
  "version": "0.2.0",
  "description": "Ask for Kloudy: CLI, MCP and SDK clients for the same scoped engine session.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "kloudy": "bin/kloudy.mjs"
  },
  "exports": {
    ".": "./src/client.mjs",
    "./mcp": "./src/mcp.mjs",
    "./wrap": "./src/wrap.mjs",
    "./session": "./src/connection.mjs"
  },
  "files": [
    "bin",
    "src",
    "schemas",
    "README.md",
    "MCP-DEFAULT.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node --check bin/kloudy.mjs && node --check src/client.mjs && npm test",
    "start": "node bin/kloudy.mjs",
    "proof": "node scripts/prove.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "zod": "4.6.5"
  }
}
